  <script>
    (function() {
      const members = {
        '910000001': { name: '陳大文', badge: '黃金會員', email: 'taiman.chen@example.com', phone: '+852 9123 4567', reward: '128,500', dcomp: '286', mascomp: '152' },
        '910000002': { name: '李小明', badge: '白銀會員', email: 'siuming.lee@example.com', phone: '+852 9234 5678', reward: '84,200', dcomp: '224', mascomp: '118' },
        '910000003': { name: '王美玲', badge: '黃金會員', email: 'meiling.wong@example.com', phone: '+852 9345 6789', reward: '153,000', dcomp: '352', mascomp: '186' },
        '910000004': { name: '張家輝', badge: '白金會員', email: 'kahui.cheung@example.com', phone: '+852 9456 7890', reward: '221,000', dcomp: '428', mascomp: '256' },
        '910000005': { name: '劉嘉欣', badge: '黃金會員', email: 'kayan.lau@example.com', phone: '+852 9567 8901', reward: '97,500', dcomp: '196', mascomp: '94' },
        '910000006': { name: '黃志強', badge: '白銀會員', email: 'chikeung.wong@example.com', phone: '+852 9678 9012', reward: '68,800', dcomp: '168', mascomp: '82' },
        '910000007': { name: '林曉彤', badge: '黃金會員', email: 'hiutung.lam@example.com', phone: '+852 9789 0123', reward: '136,000', dcomp: '314', mascomp: '166' },
        '910000008': { name: '何家俊', badge: '白金會員', email: 'kachun.ho@example.com', phone: '+852 9890 1234', reward: '254,000', dcomp: '486', mascomp: '284' },
        '910000009': { name: '周雅文', badge: '黃金會員', email: 'manching.chow@example.com', phone: '+852 9912 3456', reward: '112,000', dcomp: '264', mascomp: '138' },
        '910000010': { name: '吳國榮', badge: '白銀會員', email: 'kwokwing.ng@example.com', phone: '+852 9023 4567', reward: '73,500', dcomp: '186', mascomp: '102' }
      };

      let currentMemberId = '910000001';

      const memberName = document.getElementById('memberName');
      const memberId = document.getElementById('memberId');
      const memberEmail = document.getElementById('memberEmail');
      const memberPhone = document.getElementById('memberPhone');
      const statReward = document.getElementById('statReward');
      const statDcomp = document.getElementById('statDcomp');
      const statMascomp = document.getElementById('statMascomp');
      const memberCard = document.getElementById('memberCard');
      const searchInput = document.getElementById('searchInput');
      const searchBtn = document.getElementById('searchBtn');

      function switchMember(id) {
        const member = members[id];
        if (!member) return false;

        memberCard.classList.add('updating');

        setTimeout(() => {
          memberName.innerHTML = member.name + ' <span class="member-badge" id="memberBadge">' + member.badge + '</span>';
          memberId.textContent = id;
          memberEmail.textContent = member.email;
          memberPhone.textContent = member.phone;
          statReward.textContent = member.reward;
          statDcomp.textContent = member.dcomp;
          statMascomp.textContent = member.mascomp;
          currentMemberId = id;
          memberCard.classList.remove('updating');
        }, 200);

        return true;
      }

      function performSearch() {
        const query = searchInput.value.trim();
        if (!query) {
          alert('請輸入會員號碼');
          return;
        }

        if (members[query]) {
          switchMember(query);
          searchInput.value = '';
          const originalPlaceholder = searchInput.placeholder;
          searchInput.placeholder = '✓ 已切換至 ' + members[query].name;
          setTimeout(() => {
            searchInput.placeholder = originalPlaceholder;
          }, 1500);
        } else {
          alert('找不到會員號碼：' + query);
        }
      }

      searchBtn.addEventListener('click', performSearch);

      searchInput.addEventListener('keydown', function(e) {
        if (e.key === 'Enter') {
          e.preventDefault();
          performSearch();
        }
      });

      const sidebar = document.getElementById('sidebar');
      const toggleBtn = document.getElementById('toggleSidebar');

      toggleBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        sidebar.classList.toggle('collapsed');
        const icon = toggleBtn.querySelector('i');
        if (sidebar.classList.contains('collapsed')) {
          icon.classList.remove('fa-bars');
          icon.classList.add('fa-chevron-right');
        } else {
          icon.classList.remove('fa-chevron-right');
          icon.classList.add('fa-bars');
        }
      });

      const tabBtns = document.querySelectorAll('.tab-btn');
      const tabContents = {
        wallet: document.getElementById('tab-wallet'),
        basket: document.getElementById('tab-basket'),
        activity: document.getElementById('tab-activity'),
        rewards: document.getElementById('tab-rewards')
      };

      function activateTab(tabId) {
        tabBtns.forEach(btn => btn.classList.remove('active'));
        Object.values(tabContents).forEach(content => content.classList.remove('active'));
        const activeBtn = Array.from(tabBtns).find(btn => btn.dataset.tab === tabId);
        if (activeBtn) activeBtn.classList.add('active');
        if (tabContents[tabId]) tabContents[tabId].classList.add('active');
      }

      tabBtns.forEach(btn => {
        btn.addEventListener('click', function() {
          activateTab(this.dataset.tab);
        });
      });

      document.querySelectorAll('.tab-content').forEach(content => {
        content.addEventListener('click', function(e) {
          const btn = e.target.closest('button');
          if (!btn) return;
          const action = btn.classList.contains('btn-redeem') ? 'Redeem' :
                         btn.classList.contains('btn-void') ? 'VOID' :
                         btn.classList.contains('btn-detail') ? 'Detail' :
                         btn.classList.contains('btn-voucher') ? 'Voucher' : '';
          if (action) {
            const row = btn.closest('.item-row');
            const title = row ? row.querySelector('.item-title')?.innerText || '項目' : '項目';
            alert('您點擊了「' + action + '」：' + title);
          }
        });
      });

      const giftModal = document.getElementById('giftModal');
      const giftBtn = document.getElementById('giftBtn');
      const closeModal = document.getElementById('closeModal');
      const cancelModal = document.getElementById('cancelModal');
      const confirmModal = document.getElementById('confirmModal');
      const settleToggle = document.getElementById('settleToggle');
      const settleStatusText = document.getElementById('settleStatusText');
      const modalItems = document.querySelectorAll('.modal-item');

      giftBtn.addEventListener('click', function() {
        giftModal.classList.add('active');
        document.body.style.overflow = 'hidden';
      });

      function closeGiftModal() {
        giftModal.classList.remove('active');
        document.body.style.overflow = '';
      }

      closeModal.addEventListener('click', closeGiftModal);
      cancelModal.addEventListener('click', closeGiftModal);

      giftModal.addEventListener('click', function(e) {
        if (e.target === giftModal) closeGiftModal();
      });

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && giftModal.classList.contains('active')) closeGiftModal();
      });

      modalItems.forEach(item => {
        item.addEventListener('click', function() {
          this.classList.toggle('selected');
        });
      });

      settleToggle.addEventListener('click', function() {
        this.classList.toggle('on');
        const isOn = this.classList.contains('on');
        this.setAttribute('aria-checked', isOn);
        settleStatusText.textContent = isOn ? 'Auto Settle' : 'Open Item';
      });

      settleToggle.addEventListener('keydown', function(e) {
        if (e.key === ' ' || e.key === 'Enter') {
          e.preventDefault();
          this.click();
        }
      });

      confirmModal.addEventListener('click', function() {
        const selectedItems = [];
        document.querySelectorAll('.modal-item.selected').forEach(item => {
          selectedItems.push(item.dataset.value || item.querySelector('.modal-item-title')?.innerText);
        });

        const settleMode = settleToggle.classList.contains('on') ? 'Auto Settle' : 'Open Item';

        if (selectedItems.length === 0) {
          alert('請至少選取一個獎勵項目');
          return;
        }

        alert('已選擇贈送：\n' + selectedItems.join('\n') + '\n\n結算模式：' + settleMode);
        closeGiftModal();
      });

      switchMember('910000001');
    })();
  </script>
