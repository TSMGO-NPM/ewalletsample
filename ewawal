<!DOCTYPE html>
<html lang="zh-Hant">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.5, user-scalable=yes">
  <title>Wallet · 專業儀表板</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif;
    }

    :root {
      --green-deep: #1e7e5c;
      --green-main: #2e9b6e;
      --green-soft: #e6f5ef;
      --green-hover: #d0ebe0;
      --white: #ffffff;
      --gray-light: #f8faf9;
      --gray-border: #d9e6e0;
      --gray-text: #3b4e48;
      --shadow-sm: 0 4px 10px rgba(0, 40, 20, 0.04);
      --shadow-md: 0 8px 20px rgba(0, 40, 20, 0.06);
      --shadow-lg: 0 20px 40px rgba(0, 40, 20, 0.12);
      --radius: 16px;
      --radius-sm: 12px;
      --radius-btn: 10px;
      --black: #111111;
    }

    body {
      background-color: var(--gray-light);
      color: var(--gray-text);
      display: flex;
      min-height: 100vh;
      line-height: 1.4;
    }

    .sidebar {
      width: 260px;
      background: var(--white);
      border-right: 1px solid var(--gray-border);
      display: flex;
      flex-direction: column;
      transition: width 0.25s ease;
      box-shadow: var(--shadow-sm);
      z-index: 10;
    }

    .sidebar.collapsed {
      width: 78px;
    }

    .sidebar.collapsed .nav-label,
    .sidebar.collapsed .logo-text {
      display: none;
    }

    .sidebar.collapsed .nav-item {
      justify-content: center;
      padding: 0.9rem 0;
    }

    .sidebar.collapsed .nav-item i {
      margin-right: 0;
      font-size: 1.4rem;
    }

    .sidebar-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1.5rem 1.2rem;
      border-bottom: 1px solid var(--gray-border);
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 12px;
      font-weight: 600;
      font-size: 1.25rem;
      color: var(--green-deep);
      letter-spacing: -0.02em;
    }

    .logo i {
      font-size: 1.8rem;
      color: var(--green-main);
    }

    .toggle-btn {
      background: none;
      border: none;
      font-size: 1.2rem;
      color: var(--green-main);
      cursor: pointer;
      width: 32px;
      height: 32px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background 0.2s;
    }

    .toggle-btn:hover {
      background: var(--green-soft);
    }

    .nav {
      flex: 1;
      padding: 1.5rem 0.8rem;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .nav-item {
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 0.9rem 1rem;
      border-radius: var(--radius-sm);
      color: var(--gray-text);
      text-decoration: none;
      font-weight: 500;
      transition: background 0.2s, color 0.2s;
      white-space: nowrap;
    }

    .nav-item i {
      font-size: 1.2rem;
      width: 24px;
      text-align: center;
      color: var(--green-main);
    }

    .nav-item:hover {
      background: var(--green-soft);
      color: var(--green-deep);
    }

    .nav-item.active {
      background: var(--green-soft);
      color: var(--green-deep);
      font-weight: 600;
      border-left: 4px solid var(--green-main);
      border-radius: var(--radius-sm) 0 0 var(--radius-sm);
    }

    .sidebar.collapsed .nav-item.active {
      border-left: none;
      border-radius: var(--radius-sm);
    }

    .main {
      flex: 1;
      padding: 1.8rem 2rem;
      overflow-x: auto;
    }

    .search-section {
      display: flex;
      justify-content: flex-end;
      margin-bottom: 2rem;
    }

    .search-wrapper {
      display: flex;
      align-items: center;
      gap: 10px;
      width: 100%;
    }

    .search-input-box {
      flex: 1;
      background: var(--white);
      border: 1px solid var(--gray-border);
      border-radius: var(--radius-btn);
      padding: 0 1.2rem;
      box-shadow: var(--shadow-sm);
      transition: border 0.2s, box-shadow 0.2s;
      display: flex;
      align-items: center;
      height: 48px;
    }

    .search-input-box:focus-within {
      border-color: var(--green-main);
      box-shadow: 0 0 0 3px rgba(46, 155, 110, 0.12);
    }

    .search-input-box i {
      color: #9bb5aa;
      font-size: 0.95rem;
      margin-right: 8px;
    }

    .search-input-box input {
      flex: 1;
      border: none;
      outline: none;
      font-size: 0.95rem;
      padding: 0.7rem 0;
      background: transparent;
      color: var(--gray-text);
      height: 100%;
    }

    .search-input-box input::placeholder {
      color: #9bb5aa;
    }

    .search-btn {
      background: var(--green-main);
      border: none;
      color: white;
      height: 48px;
      padding: 0 1.8rem;
      border-radius: var(--radius-btn);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      font-size: 1rem;
      font-weight: 600;
      gap: 8px;
      transition: background 0.2s, box-shadow 0.2s;
      flex-shrink: 0;
      box-shadow: 0 4px 10px rgba(46, 155, 110, 0.25);
      white-space: nowrap;
    }

    .search-btn:hover {
      background: var(--green-deep);
      box-shadow: 0 6px 14px rgba(46, 155, 110, 0.35);
    }

    .member-card {
      background: var(--white);
      border-radius: var(--radius);
      padding: 1.5rem 2rem;
      box-shadow: var(--shadow-md);
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 2rem;
      margin-bottom: 2rem;
      border: 1px solid rgba(46, 155, 110, 0.1);
      transition: opacity 0.25s ease;
    }

    .member-card.updating {
      opacity: 0.6;
    }

    .member-avatar {
      width: 72px;
      height: 72px;
      border-radius: 50%;
      background: var(--green-soft);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2.2rem;
      color: var(--green-main);
      font-weight: 300;
      flex-shrink: 0;
    }

    .member-info h2 {
      font-size: 1.5rem;
      font-weight: 600;
      color: var(--green-deep);
      margin-bottom: 0.2rem;
    }

    .member-info p {
      color: #5f7a70;
      font-size: 0.95rem;
    }

    .member-badge {
      background: var(--green-soft);
      color: var(--green-deep);
      padding: 0.3rem 1rem;
      border-radius: 30px;
      font-size: 0.85rem;
      font-weight: 600;
      margin-left: 0.8rem;
      display: inline-block;
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
      margin-bottom: 2.2rem;
    }

    .stat-card {
      background: var(--white);
      border-radius: var(--radius);
      padding: 1.5rem 1.5rem;
      box-shadow: var(--shadow-sm);
      border: 1px solid var(--gray-border);
      transition: transform 0.2s, box-shadow 0.2s;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .stat-card:hover {
      box-shadow: var(--shadow-md);
      transform: translateY(-2px);
    }

    .stat-title {
      font-size: 0.9rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      font-weight: 600;
      color: #5b7a6e;
    }

    .stat-value {
      font-size: 2.6rem;
      font-weight: 800;
      color: var(--black);
      line-height: 1.1;
      letter-spacing: -0.02em;
    }

    .stat-icon {
      font-size: 1.8rem;
      color: var(--green-main);
      margin-bottom: 0.2rem;
    }

    .stat-card small {
      color: #8aa89b;
      font-size: 0.8rem;
    }

    .tabs-header {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1.2rem;
      gap: 1rem;
    }

    .tabs {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .tab-btn {
      background: transparent;
      border: 1px solid var(--gray-border);
      padding: 0.6rem 1.4rem;
      border-radius: 40px;
      font-size: 0.9rem;
      font-weight: 500;
      color: var(--gray-text);
      cursor: pointer;
      transition: all 0.2s;
      white-space: nowrap;
    }

    .tab-btn i {
      margin-right: 0.4rem;
      font-size: 0.9rem;
    }

    .tab-btn:hover {
      background: var(--green-soft);
      border-color: var(--green-main);
      color: var(--green-deep);
    }

    .tab-btn.active {
      background: var(--green-main);
      border-color: var(--green-main);
      color: white;
      font-weight: 600;
    }

    .tab-btn.active i {
      color: white;
    }

    .gift-btn {
      background: var(--green-main);
      border: none;
      color: white;
      padding: 0.7rem 1.6rem;
      border-radius: 40px;
      font-weight: 600;
      font-size: 0.95rem;
      display: flex;
      align-items: center;
      gap: 0.6rem;
      cursor: pointer;
      transition: background 0.2s, box-shadow 0.2s;
      box-shadow: 0 4px 10px rgba(46, 155, 110, 0.3);
      white-space: nowrap;
    }

    .gift-btn:hover {
      background: var(--green-deep);
      box-shadow: 0 6px 14px rgba(46, 155, 110, 0.4);
    }

    .gift-btn i {
      font-size: 1rem;
    }

    .tab-content {
      display: none;
      flex-direction: column;
      gap: 1rem;
      margin-top: 0.5rem;
    }

    .tab-content.active {
      display: flex;
    }

    .item-row {
      background: var(--white);
      border-radius: var(--radius-sm);
      padding: 1.2rem 1.5rem;
      border: 1px solid var(--gray-border);
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      box-shadow: var(--shadow-sm);
      transition: box-shadow 0.2s;
    }

    .item-row:hover {
      box-shadow: var(--shadow-md);
    }

    .item-info {
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
    }

    .item-title {
      font-weight: 600;
      font-size: 1.05rem;
      color: var(--green-deep);
    }

    .item-desc {
      font-size: 0.85rem;
      color: #6c8b7d;
    }

    .item-actions {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      align-items: stretch;
      min-width: 105px;
    }

    .item-actions button {
      border: none;
      padding: 0.5rem 0.8rem;
      border-radius: 8px;
      font-size: 0.8rem;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.2s, transform 0.1s;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.4rem;
      letter-spacing: 0.2px;
    }

    .item-actions button:active {
      transform: scale(0.97);
    }

    .btn-redeem {
      background: var(--green-soft);
      color: var(--green-deep);
      border: 1px solid var(--green-main) !important;
    }

    .btn-redeem:hover {
      background: var(--green-main);
      color: white;
    }

    .btn-void {
      background: #fdecec;
      color: #b33a3a;
      border: 1px solid #e0a0a0 !important;
    }

    .btn-void:hover {
      background: #b33a3a;
      color: white;
    }

    .btn-detail {
      background: transparent;
      color: var(--gray-text);
      border: 1px solid var(--gray-border) !important;
    }

    .btn-detail:hover {
      background: #f0f5f2;
    }

    .btn-voucher {
      background: var(--white);
      color: var(--green-deep);
      border: 1px solid var(--green-main) !important;
    }

    .btn-voucher:hover {
      background: var(--green-soft);
    }

    .modal-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(20, 50, 40, 0.45);
      backdrop-filter: blur(2px);
      align-items: center;
      justify-content: center;
      z-index: 1000;
      padding: 1.5rem;
    }

    .modal-overlay.active {
      display: flex;
    }

    .modal-container {
      background: var(--white);
      border-radius: var(--radius);
      width: 100%;
      max-width: 560px;
      max-height: 90vh;
      overflow-y: auto;
      box-shadow: var(--shadow-lg);
      animation: modalFadeIn 0.25s ease;
      border: 1px solid rgba(46, 155, 110, 0.15);
    }

    @keyframes modalFadeIn {
      from { opacity: 0; transform: translateY(16px) scale(0.97); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }

    .modal-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1.5rem 1.8rem 0.8rem;
      border-bottom: 1px solid var(--gray-border);
    }

    .modal-header h3 {
      font-size: 1.3rem;
      font-weight: 600;
      color: var(--green-deep);
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }

    .modal-header h3 i {
      color: var(--green-main);
    }

    .modal-close {
      background: none;
      border: none;
      font-size: 1.4rem;
      color: #9bb5aa;
      cursor: pointer;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background 0.2s, color 0.2s;
    }

    .modal-close:hover {
      background: var(--green-soft);
      color: var(--green-deep);
    }

    .modal-body {
      padding: 1.2rem 1.8rem 1.8rem;
    }

    .modal-item-list {
      display: flex;
      flex-direction: column;
      gap: 0.7rem;
      margin-bottom: 1.5rem;
    }

    .modal-item {
      display: flex;
      align-items: center;
      gap: 1rem;
      background: var(--gray-light);
      border: 1px solid var(--gray-border);
      border-radius: var(--radius-sm);
      padding: 0.9rem 1.2rem;
      cursor: pointer;
      transition: background 0.2s, border-color 0.2s;
      user-select: none;
    }

    .modal-item:hover {
      background: var(--green-soft);
      border-color: var(--green-main);
    }

    .modal-item.selected {
      background: var(--green-soft);
      border-color: var(--green-main);
      box-shadow: 0 0 0 2px rgba(46, 155, 110, 0.15);
    }

    .modal-item-check {
      width: 22px;
      height: 22px;
      border-radius: 50%;
      border: 2px solid var(--gray-border);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      transition: all 0.15s;
      color: transparent;
      font-size: 0.7rem;
    }

    .modal-item.selected .modal-item-check {
      background: var(--green-main);
      border-color: var(--green-main);
      color: white;
    }

    .modal-item-info {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
    }

    .modal-item-title {
      font-weight: 600;
      font-size: 0.95rem;
      color: var(--gray-text);
    }

    .modal-item-desc {
      font-size: 0.8rem;
      color: #7f9e92;
    }

    .modal-settle-toggle {
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: var(--gray-light);
      border: 1px solid var(--gray-border);
      border-radius: var(--radius-sm);
      padding: 0.9rem 1.2rem;
      margin-bottom: 1.5rem;
      gap: 1rem;
    }

    .settle-label {
      display: flex;
      align-items: center;
      gap: 0.8rem;
      font-weight: 500;
      font-size: 0.95rem;
      color: var(--gray-text);
    }

    .settle-label i {
      color: var(--green-main);
      font-size: 1.1rem;
    }

    .toggle-switch {
      position: relative;
      width: 52px;
      height: 28px;
      background: #ccdcd5;
      border-radius: 30px;
      cursor: pointer;
      transition: background 0.25s;
      flex-shrink: 0;
    }

    .toggle-switch::after {
      content: '';
      position: absolute;
      top: 3px;
      left: 3px;
      width: 22px;
      height: 22px;
      background: white;
      border-radius: 50%;
      transition: transform 0.25s, box-shadow 0.2s;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
    }

    .toggle-switch.on {
      background: var(--green-main);
    }

    .toggle-switch.on::after {
      transform: translateX(24px);
    }

    .settle-status-text {
      font-weight: 600;
      font-size: 0.85rem;
      color: var(--green-deep);
      min-width: 80px;
      text-align: right;
    }

    .modal-footer {
      display: flex;
      justify-content: flex-end;
      gap: 0.8rem;
      padding-top: 0.5rem;
    }

    .modal-btn {
      padding: 0.7rem 1.8rem;
      border-radius: var(--radius-btn);
      font-weight: 600;
      font-size: 0.95rem;
      cursor: pointer;
      border: none;
      transition: background 0.2s, box-shadow 0.2s;
    }

    .modal-btn-cancel {
      background: transparent;
      color: var(--gray-text);
      border: 1px solid var(--gray-border);
    }

    .modal-btn-cancel:hover {
      background: var(--gray-light);
    }

    .modal-btn-confirm {
      background: var(--green-main);
      color: white;
      box-shadow: 0 4px 10px rgba(46, 155, 110, 0.3);
    }

    .modal-btn-confirm:hover {
      background: var(--green-deep);
      box-shadow: 0 6px 14px rgba(46, 155, 110, 0.4);
    }

    @media (max-width: 1024px) {
      .stats-grid {
        gap: 1rem;
      }
      .stat-value {
        font-size: 2rem;
      }
    }

    @media (max-width: 768px) {
      body {
        flex-direction: column;
      }

      .sidebar {
        width: 100%;
        border-right: none;
        border-bottom: 1px solid var(--gray-border);
      }

      .sidebar.collapsed {
        width: 100%;
      }

      .sidebar.collapsed .nav-label {
        display: inline;
      }

      .sidebar.collapsed .nav-item {
        justify-content: flex-start;
        padding: 0.9rem 1rem;
      }

      .sidebar.collapsed .logo-text {
        display: inline;
      }

      .nav {
        flex-direction: row;
        flex-wrap: wrap;
        padding: 0.8rem;
      }

      .nav-item {
        flex: 1 0 auto;
        justify-content: center;
        padding: 0.7rem;
      }

      .nav-item span {
        display: inline;
      }

      .sidebar.collapsed .nav-item i {
        margin-right: 0.5rem;
      }

      .main {
        padding: 1.5rem 1rem;
      }

      .member-card {
        padding: 1.2rem;
        gap: 1rem;
      }

      .stats-grid {
        grid-template-columns: 1fr;
      }

      .stat-value {
        font-size: 2.4rem;
      }

      .item-row {
        flex-direction: column;
        align-items: flex-start;
        gap: 1rem;
      }

      .item-actions {
        flex-direction: row;
        flex-wrap: wrap;
        width: 100%;
        min-width: unset;
      }

      .item-actions button {
        flex: 1;
        padding: 0.6rem 0.5rem;
      }

      .tabs-header {
        flex-direction: column;
        align-items: stretch;
      }

      .gift-btn {
        justify-content: center;
      }

      .search-wrapper {
        flex-direction: column;
      }

      .search-btn {
        width: 100%;
        justify-content: center;
      }

      .modal-container {
        max-width: 100%;
        margin: 0.5rem;
      }

      .modal-settle-toggle {
        flex-wrap: wrap;
      }
    }

    @media (max-width: 480px) {
      .member-card {
        flex-direction: column;
        text-align: center;
      }

      .member-info h2 {
        font-size: 1.3rem;
      }

      .tab-btn {
        flex: 1;
        padding: 0.5rem 0.8rem;
        font-size: 0.8rem;
      }

      .tab-btn i {
        margin-right: 0.2rem;
      }

      .modal-item {
        padding: 0.7rem 0.9rem;
      }

      .modal-footer {
        flex-direction: column;
      }

      .modal-btn {
        width: 100%;
        text-align: center;
      }
    }
  </style>
</head>
<body>

  <aside class="sidebar" id="sidebar">
    <div class="sidebar-header">
      <div class="logo">
        <i class="fas fa-wallet"></i>
        <span class="logo-text">Wallet</span>
      </div>
      <button class="toggle-btn" id="toggleSidebar" aria-label="摺叠導覽">
        <i class="fas fa-bars"></i>
      </button>
    </div>

    <nav class="nav">
      <a href="#" class="nav-item active">
        <i class="fas fa-home"></i>
        <span class="nav-label">首頁</span>
      </a>
      <a href="#" class="nav-item">
        <i class="fas fa-user"></i>
        <span class="nav-label">會員</span>
      </a>
      <a href="#" class="nav-item">
        <i class="fas fa-chart-pie"></i>
        <span class="nav-label">統計</span>
      </a>
      <a href="#" class="nav-item">
        <i class="fas fa-file-alt"></i>
        <span class="nav-label">報告</span>
      </a>
    </nav>
  </aside>

  <main class="main">

    <div class="search-section">
